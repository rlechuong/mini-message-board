<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mini Message Board</title>
  </head>
  <body>
    <h1>Message Details</h1>

    <h3>Text</h3>
    <p><%= message.text %></p>
    <h3>User</h3>
    <p><%= message.user %></p>
    <h3>Date</h3>
    <p>
      <%= message.added.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric"
      }) %>
    </p>

    <a href="/">Back To Board</a>
  </body>
</html>
