<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mini Message Board</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <header>
      <h1><%= title %></h1>
      <a href="/new">New Message</a>
    </header>
    <ul>
      <% messages.forEach((message, index) => { %>
        <li>
          <h3>User: <%= message.user %></h3>
          <p>Text: <%= message.text %></p>
          <p>Date:
            <%= message.added.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric"
            }) %>
          </p>

          <a href="/messages/<%= index %>">Message Details</a>
        </li>
      <% }); %>
    </ul>
  </body>
</html>
